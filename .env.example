# By default the system runs fully locally via Ollama — no API key needed.
# To use OpenAI instead, uncomment and fill in your key.

# OPENAI_API_KEY=sk-...

# ── Langfuse observability (optional) ─────────────────────────────────────────
# Sign up at https://cloud.langfuse.com (free tier available).
# When set, every LLM call, tool call, and routing decision is traced automatically.
#
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # default; override for self-hosted instances

# ── OpenAI model selection (only used when OPENAI_API_KEY is set) ──────────────
#
# Smart model: reasoning, tool use, complex generation — Coach and Generator
# OPENAI_SMART_MODEL=gpt-4o          # default
#
# Fast model: classification, extraction, binary checks — Router, Logger, Resolution
# OPENAI_FAST_MODEL=gpt-4o-mini      # default
#
# When running locally, both roles use the same Ollama model.
# LOCAL_MODEL=qwen2.5:1.5b           # default — fast, ~1 GB
# LOCAL_MODEL=qwen2.5:7b             # higher quality — recommended on Apple Silicon / GPU
